---
import Divider from "../../components/ornaments/Divider.astro";
import PostMeta from "../../components/PostMeta.astro";
import { SITE } from "../../config/site";
import Base from "../../layouts/Base.astro";
import { getVisiblePosts, postPath, RSS_PATH } from "../../lib/posts";

const posts = await getVisiblePosts();
const hasPosts = posts.length > 0;
---

<Base title={`Blog | ${SITE.name}`} description={`Writing by ${SITE.name}.`}>
  <main class="container blog">
    <header class="intro">
      <h1>Blog</h1>
      <Divider />
      {hasPosts && <a class="feed" href={RSS_PATH}>RSS feed</a>}
    </header>

    {
      hasPosts ? (
        <ol class="posts">
          {posts.map((post) => (
            <li>
              <article>
                <PostMeta date={post.data.date} tags={post.data.tags} draft={post.data.draft} />
                <h2>
                  <a href={postPath(post)}>{post.data.title}</a>
                </h2>
                <p class="description">{post.data.description}</p>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">
          Nothing published yet. <a href="/">Back to the home page</a>
        </p>
      )
    }
  </main>
</Base>

<style>
  .blog {
    max-width: 820px;
    padding-top: clamp(56px, 12vw, 104px);
    padding-bottom: clamp(88px, 14vw, 136px);
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: clamp(48px, 10vw, 80px);
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 9vw, 72px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--gold-bright);
    text-shadow: 0 4px 18px rgb(0 0 0 / 0.6);
  }

  .feed {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .posts {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    padding: clamp(24px, 6vw, 36px) 0;
    border-top: 1px solid var(--night-line);
  }

  .posts li:last-child {
    border-bottom: 1px solid var(--night-line);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--text-muted);
  }

  h2 {
    font-size: clamp(23px, 6vw, 30px);
    font-weight: 600;
    line-height: 1.25;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--link-hover);
  }

  .description {
    max-width: 680px;
    color: var(--text-soft);
  }

  .empty {
    text-align: center;
    color: var(--text-muted);
  }
</style>
