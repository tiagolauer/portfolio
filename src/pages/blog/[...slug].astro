---
import { render } from "astro:content";
import Parchment from "../../components/ornaments/Parchment.astro";
import PostMeta from "../../components/PostMeta.astro";
import { SITE } from "../../config/site";
import Base from "../../layouts/Base.astro";
import { BLOG_PATH, getVisiblePosts, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const replyHref = `mailto:${SITE.email}?subject=${encodeURIComponent(`Re: ${post.data.title}`)}`;
---

<Base title={`${post.data.title} | ${SITE.name}`} description={post.data.description} type="article">
  <main class="container reading">
    <a class="back" href={BLOG_PATH}>All posts</a>

    <Parchment as="article">
      <header class="post-header">
        <PostMeta date={post.data.date} tags={post.data.tags} draft={post.data.draft} />
        <h1>{post.data.title}</h1>
        <p class="description">{post.data.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </Parchment>

    <footer class="post-footer">
      <a href={replyHref}>Reply by email</a>
      <a href={BLOG_PATH}>All posts</a>
    </footer>
  </main>
</Base>

<style>
  .reading {
    max-width: 820px;
    padding-top: clamp(28px, 6vw, 48px);
    padding-bottom: clamp(88px, 14vw, 136px);
  }

  .back,
  .post-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .back {
    margin-bottom: clamp(16px, 4vw, 28px);
  }

  .post-header {
    --meta-accent: var(--ink-accent);
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: clamp(20px, 5vw, 28px);
    margin-bottom: clamp(20px, 5vw, 28px);
    border-bottom: 1px solid rgb(107 74 28 / 0.35);
    color: var(--ink-muted);
  }

  h1 {
    font-size: clamp(30px, 7vw, 44px);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
  }

  .description {
    font-size: clamp(18px, 5vw, 21px);
    font-style: italic;
  }

  .post-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(28px, 6vw, 44px);
  }

  .prose {
    font-size: clamp(17px, 4.8vw, 19px);
    line-height: 1.7;
    color: var(--ink);
  }

  .prose > :global(* + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 1.8em;
    font-size: clamp(23px, 6vw, 28px);
    font-weight: 600;
    line-height: 1.25;
  }

  .prose :global(h3) {
    margin-top: 1.5em;
    font-size: clamp(20px, 5.4vw, 23px);
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-bottom: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 0.2em 0 0.2em 1.1em;
    border-left: 3px solid var(--gold-line);
    font-style: italic;
    color: var(--ink-muted);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgb(107 74 28 / 0.14);
    font-family: var(--font-code);
    font-size: 0.85em;
  }

  .prose :global(pre) {
    padding: 16px 18px;
    border-radius: 6px;
    overflow-x: auto;
    font-family: var(--font-code);
    font-size: clamp(13px, 3.6vw, 15px);
    line-height: 1.6;
    box-shadow: 0 8px 22px rgb(0 0 0 / 0.25);
  }

  .prose :global(pre code) {
    font-family: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgb(107 74 28 / 0.35);
  }
</style>
