---
interface Props {
  href: string;
  label: string;
  initials: string;
}

const { href, label, initials } = Astro.props;
---

<a class="seal" href={href}>
  <span>{initials}</span>
  <span class="visually-hidden">, {label}</span>
</a>

<style>
  .seal {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    margin-top: 8px;
    border-radius: 50%;
    text-decoration: none;
    background: radial-gradient(circle at 35% 30%, #d2453a 0%, #9e1f17 45%, #5e0e0a 100%);
    box-shadow:
      inset 0 0 0 6px rgb(94 14 10 / 0.55),
      inset 0 0 0 8px rgb(255 170 150 / 0.18),
      0 8px 22px rgb(0 0 0 / 0.55);
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }

  .seal:hover {
    text-shadow: none;
  }

  .seal:active {
    transform: scale(0.96);
  }

  @media (hover: hover) {
    .seal:hover {
      transform: rotate(-8deg) scale(1.05);
      filter: brightness(1.12);
    }
  }

  span:not(.visually-hidden) {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #f4c7b8;
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .seal:hover {
      transform: none;
    }
  }
</style>
