---
interface Props {
  fade?: "start" | "end";
}

const { fade = "start" } = Astro.props;
---

<span class:list={["rule", fade]} aria-hidden="true"></span>

<style>
  .rule {
    flex: 1 1 40px;
    height: 1px;
  }

  .start {
    background: linear-gradient(90deg, rgb(201 164 76 / 0), var(--gold));
  }

  .end {
    background: linear-gradient(90deg, var(--gold), rgb(201 164 76 / 0));
  }
</style>
