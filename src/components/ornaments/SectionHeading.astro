---
import Diamond from "./Diamond.astro";
import Rule from "./Rule.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="heading">
  <Rule fade="start" />
  <Diamond />
  <h2 id={id}><slot /></h2>
  <Diamond />
  <Rule fade="end" />
</div>

<style>
  .heading {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(12px, 3vw, 18px);
    width: 100%;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 7vw, 40px);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.15;
    color: var(--link);
    text-align: center;
    scroll-margin-top: calc(var(--header-height) + 24px);
  }

  @media (max-width: 480px) {
    .heading :global(.rule) {
      display: none;
    }
  }
</style>
