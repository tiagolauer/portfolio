---
import Diamond from "./Diamond.astro";
import Rule from "./Rule.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="heading">
  <Rule fade="start" />
  <Diamond />
  <h2 id={id}><slot /></h2>
  <Diamond />
  <Rule fade="end" />
</div>

<style>
  .heading {
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.15;
    color: var(--link);
    text-align: center;
    scroll-margin-top: 32px;
  }
</style>
