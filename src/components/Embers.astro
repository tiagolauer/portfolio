---
const DEFAULT_COUNT = 28;
const SIZE_BASE_PX = 2;
const SIZE_SPREAD = 4;
const DURATION_BASE_S = 8;
const DURATION_SPREAD = 9;
const DELAY_SPREAD = 15;
const HORIZONTAL_STEP = 37;
const HORIZONTAL_OFFSET = 11;

interface Props {
  count?: number;
}

const { count = DEFAULT_COUNT } = Astro.props;

const embers = Array.from({ length: count }, (_, index) => {
  const size = SIZE_BASE_PX + ((index * 7) % SIZE_SPREAD);
  const left = (index * HORIZONTAL_STEP + HORIZONTAL_OFFSET) % 100;
  const duration = DURATION_BASE_S + ((index * 13) % DURATION_SPREAD);
  const delay = -((index * 17) % DELAY_SPREAD);
  const path = index % 2 === 0 ? "rise-left" : "rise-right";
  return `left:${left}%;width:${size}px;height:${size}px;animation:${path} ${duration}s linear ${delay}s infinite`;
});
---

<div class="embers" aria-hidden="true">
  {embers.map((style) => <span class="ember" style={style} />)}
</div>

<style>
  .embers {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ember {
    position: absolute;
    bottom: -12px;
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(circle, #ffe3a0 0%, #f28a2e 55%, rgb(242 138 46 / 0) 72%);
    box-shadow: 0 0 10px 2px rgb(242 120 40 / 0.55);
  }

  @keyframes rise-left {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0;
    }
    10% {
      opacity: 0.95;
    }
    60% {
      transform: translate(28px, -380px) scale(0.8);
      opacity: 0.7;
    }
    100% {
      transform: translate(-10px, -680px) scale(0.4);
      opacity: 0;
    }
  }

  @keyframes rise-right {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0;
    }
    12% {
      opacity: 0.9;
    }
    55% {
      transform: translate(-26px, -340px) scale(0.85);
      opacity: 0.65;
    }
    100% {
      transform: translate(18px, -660px) scale(0.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .embers {
      display: none;
    }
  }
</style>
