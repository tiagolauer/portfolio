---
import { NAV_WITH_BLOG, NAV_WITHOUT_BLOG, SITE } from "../config/site";
import { BLOG_PATH, getVisiblePosts } from "../lib/posts";

const hasPosts = (await getVisiblePosts()).length > 0;
const items = hasPosts ? NAV_WITH_BLOG : NAV_WITHOUT_BLOG;
const isInBlog = Astro.url.pathname.startsWith(BLOG_PATH);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Sections">
      {
        items.map((item) => (
          <a href={item.href} aria-current={isInBlog && item.href === BLOG_PATH ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(18 16 12 / 0.94);
    border-bottom: 1px solid rgb(58 47 30 / 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    gap: 24px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.1em;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-nav);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a[aria-current="page"] {
    color: var(--link-hover);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  @media (max-width: 600px) {
    .brand {
      display: none;
    }

    nav {
      flex: 1;
      justify-content: space-between;
      gap: 12px;
      font-size: clamp(12px, 3.4vw, 14px);
      letter-spacing: 0.04em;
    }
  }

  @media (max-width: 359px) {
    nav {
      gap: 8px;
      letter-spacing: 0;
    }
  }
</style>
