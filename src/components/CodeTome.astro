---
import { SNIPPET_FILE_NAME, SNIPPET_LINES, TOOLTIP_AFTER_LINE_INDEX, TOOLTIP_LINES } from "../data/owlsql-snippet";
import Parchment from "./ornaments/Parchment.astro";
---

<figure class="tome">
  <Parchment padding="none">
    <div class="tab">{SNIPPET_FILE_NAME}</div>
    <div class="code" tabindex="0" role="region" aria-label={`Example: ${SNIPPET_FILE_NAME}`}>
      <code>
        {
          SNIPPET_LINES.map((line, index) => (
            <Fragment>
              <span class="line">
                <span class="line-number" aria-hidden="true">
                  {index + 1}
                </span>
                {line.map((token) => (
                  <span class={`token-${token.kind}`}>{token.text}</span>
                ))}
              </span>
              {index === TOOLTIP_AFTER_LINE_INDEX && (
                <span class="tooltip" role="note" aria-label="Inferred type of result">
                  {TOOLTIP_LINES.map((tooltipLine) => (
                    <span class="line">
                      {tooltipLine.map((token) => (
                        <span class={`tooltip-${token.kind}`}>{token.text}</span>
                      ))}
                    </span>
                  ))}
                </span>
              )}
            </Fragment>
          ))
        }
      </code>
    </div>
  </Parchment>
  <figcaption>
    OwlSQL in one screen: the query is a plain string, and TypeScript already knows the shape of what comes back.
  </figcaption>
</figure>

<style>
  .tome {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: -64px 0 0;
  }

  .tab {
    display: inline-block;
    margin: 16px 24px 0;
    padding-bottom: 4px;
    border-bottom: 1px solid rgb(107 74 28 / 0.45);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #6b4a1c;
  }

  .code {
    padding: 16px 0 30px;
    overflow-x: auto;
    font-family: var(--font-code);
    font-size: 15px;
    line-height: 1.85;
    color: var(--ink);
  }

  .code:focus-visible {
    outline: 2px solid var(--ink-accent);
    outline-offset: -4px;
  }

  code {
    display: flex;
    flex-direction: column;
    width: max-content;
    min-width: 100%;
    font: inherit;
  }

  .line {
    display: flex;
    min-height: 1.85em;
    white-space: pre;
  }

  .line-number {
    flex: 0 0 48px;
    padding-right: 20px;
    text-align: right;
    color: var(--ink-faint);
    user-select: none;
  }

  .token-keyword {
    color: var(--ink-accent);
  }

  .token-string {
    color: var(--ink-green);
  }

  .token-hovered {
    padding: 0 3px;
    border-radius: 3px;
    background: rgb(201 164 76 / 0.5);
    box-shadow: 0 0 0 1px rgb(122 90 30 / 0.5);
  }

  .tooltip {
    display: flex;
    flex-direction: column;
    align-self: flex-start;
    margin: 6px 24px 12px 128px;
    padding: 14px 18px;
    border: 1px solid #8a8f9c;
    border-radius: 5px;
    outline: 1px solid #2a2e3c;
    outline-offset: -4px;
    background: rgb(8 10 28 / 0.94);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.5);
    font-size: 14px;
    line-height: 1.75;
    color: #fff;
    animation: tooltip-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 1.4s both;
  }

  .tooltip .line {
    min-height: 1.75em;
  }

  .tooltip-keyword {
    color: var(--gold);
  }

  .tooltip-name {
    font-weight: 500;
    color: var(--epic-text);
  }

  .tooltip-result {
    font-weight: 500;
    color: var(--legendary-text);
  }

  .tooltip-primitive {
    color: #8fc1ff;
  }

  .tooltip-error {
    color: #4ce06a;
  }

  @keyframes tooltip-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .tab {
      margin: 14px 18px 0;
    }

    .code {
      padding: 12px 12px 22px 0;
      font-size: clamp(12px, 3.7vw, 15px);
    }

    .line-number {
      flex-basis: 34px;
      padding-right: 12px;
    }

    .tooltip {
      margin: 6px 0 10px 34px;
      padding: 10px 12px;
      font-size: 0.93em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tooltip {
      animation: none;
    }
  }

  figcaption {
    align-self: center;
    max-width: 640px;
    font-size: 17px;
    font-style: italic;
    text-align: center;
    color: var(--text-muted);
  }
</style>
