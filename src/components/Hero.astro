---
import { NAV_ITEMS, SECTION_ID, SITE } from "../config/site";
import Embers from "./Embers.astro";
import Divider from "./ornaments/Divider.astro";
---

<div class="night">
  <Embers />

  <header class="container header">
    <a class="brand" href={`#${SECTION_ID.top}`}>{SITE.name}</a>
    <nav aria-label="Sections">
      {NAV_ITEMS.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
    </nav>
  </header>

  <section class="container hero" id={SECTION_ID.top}>
    <h1>{SITE.name}</h1>
    <Divider />
    <p class="lead">
      Software engineer in Brusque, Brazil. I work across TypeScript, Vue, React Native and .NET, and I wrote{" "}
      <a href={`#${SECTION_ID.openSource}`}>OwlSQL</a>, a library that type-checks raw SQL at compile time.
    </p>
    <p class="aside">
      Looking for a remote role on a product team. <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </section>
</div>

<style>
  .night {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--night-line);
    background-color: var(--night);
    background-image:
      radial-gradient(ellipse 80% 55% at 50% 118%, rgb(232 119 46 / 0.34), rgb(232 119 46 / 0) 70%),
      radial-gradient(ellipse 60% 40% at 50% -10%, rgb(80 70 120 / 0.28), rgb(80 70 120 / 0) 70%),
      radial-gradient(1.2px 1.2px at 12% 18%, rgb(255 240 200 / 0.8), transparent),
      radial-gradient(1px 1px at 27% 42%, rgb(255 240 200 / 0.6), transparent),
      radial-gradient(1.4px 1.4px at 71% 12%, rgb(255 240 200 / 0.85), transparent),
      radial-gradient(1px 1px at 84% 36%, rgb(255 240 200 / 0.6), transparent),
      radial-gradient(1px 1px at 46% 8%, rgb(255 240 200 / 0.7), transparent),
      radial-gradient(1.2px 1.2px at 92% 64%, rgb(255 240 200 / 0.5), transparent),
      radial-gradient(1px 1px at 6% 58%, rgb(255 240 200 / 0.5), transparent);
  }

  .header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    padding-top: 24px;
  }

  .brand {
    padding: 10px 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.1em;
  }

  nav a {
    padding: 10px 0;
    color: var(--text-nav);
    text-decoration: none;
  }

  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-top: 104px;
    padding-bottom: 120px;
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(54px, 9vw, 116px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    background: linear-gradient(
      100deg,
      var(--gold-deep) 0%,
      var(--gold) 25%,
      var(--gold-pale) 45%,
      var(--gold-bright) 55%,
      var(--gold) 75%,
      var(--gold-deep) 100%
    );
    background-size: 260% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    filter: drop-shadow(0 4px 18px rgb(0 0 0 / 0.6));
    animation: shimmer 7s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1 {
      animation: none;
      background-position: 50% 0;
    }
  }

  .lead {
    max-width: 640px;
    font-size: 23px;
    line-height: 1.5;
    color: #ede3cc;
  }

  .aside {
    max-width: 640px;
    font-style: italic;
    color: var(--text-muted);
  }

  .aside a {
    font-style: normal;
  }
</style>
